#!/bin/bash
# ty has no PEP 723 support: it can't see a script's inline dependencies, so it
# reports every third-party import as unresolved. Fix that by exporting
# VIRTUAL_ENV pointing at the environment uv already builds for the script.
#
# Helix spawns language servers with its own cwd, so $PWD is already the
# workspace root — no need to interrogate the parent process for it.
exec 2>>"${TMPDIR:-/tmp}/ty-wrapper.log"

# Reads at most 30 lines and forks nothing.
has_pep723() {
  local line n=0
  while IFS= read -r line; do
    [[ $line == '# /// script'* ]] && return 0
    ((++n >= 30)) && return 1
  done <"$1"
  return 1
}

script=""
# An already-active venv wins; the user picked it deliberately.
if [[ -z $VIRTUAL_ENV ]]; then
  if [[ -n $PEP723_SCRIPT && -r $PEP723_SCRIPT ]]; then
    # The `hx` shell function names the script outright — always correct.
    script=$PEP723_SCRIPT
  else
    # Opened as `hx .` or through the file picker. Accept the workspace's sole
    # PEP 723 script; with several, stay out of it rather than guess, since one
    # VIRTUAL_ENV cannot serve two different dependency sets.
    for f in "$PWD"/*.py; do
      [[ -r $f ]] && has_pep723 "$f" || continue
      [[ -n $script ]] && { script=""; break; }
      script=$f
    done
  fi
fi

if [[ -n $script ]] && uv sync --script "$script" >/dev/null 2>&1; then
  venv=$(uv python find --script "$script" 2>/dev/null)
  venv=${venv%/bin/*}
  # An unsynced script yields a bare interpreter path, not a venv; pyvenv.cfg is
  # what tells the two apart.
  [[ -f $venv/pyvenv.cfg ]] && export VIRTUAL_ENV="$venv"
fi

exec ty server
